---
import { SOCIAL, EMAIL } from '../consts';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container-wide footer-inner">
    <div class="copy">
      © {year} Sai Vijay Bhaskar Mocherla.
      <span class="dot">·</span>
      <a href="/rss.xml">RSS</a>
    </div>
    <div class="social" aria-label="Social links">
      <a href={`mailto:${EMAIL}`} aria-label="Email" title="Email">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
          <polyline points="22,6 12,13 2,6"/>
        </svg>
      </a>
      <a href={SOCIAL.github} target="_blank" rel="noopener" aria-label="GitHub" title="GitHub">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 .5C5.73.5.7 5.54.7 11.82c0 5.02 3.25 9.27 7.77 10.77.57.1.78-.25.78-.55v-2.04c-3.16.69-3.83-1.36-3.83-1.36-.52-1.31-1.27-1.66-1.27-1.66-1.04-.71.08-.7.08-.7 1.14.08 1.74 1.18 1.74 1.18 1.02 1.74 2.67 1.24 3.32.95.1-.74.4-1.24.72-1.53-2.52-.29-5.17-1.26-5.17-5.61 0-1.24.44-2.26 1.17-3.05-.12-.29-.51-1.45.11-3.03 0 0 .96-.31 3.13 1.17a10.93 10.93 0 0 1 5.7 0c2.17-1.48 3.12-1.17 3.12-1.17.62 1.58.23 2.74.11 3.03.73.79 1.17 1.81 1.17 3.05 0 4.36-2.65 5.32-5.18 5.6.41.35.78 1.03.78 2.08v3.08c0 .3.21.65.79.54 4.51-1.5 7.76-5.75 7.76-10.77C23.3 5.54 18.27.5 12 .5z"/>
        </svg>
      </a>
      <a href={SOCIAL.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn" title="LinkedIn">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.13 1.45-2.13 2.94v5.67H9.36V9h3.41v1.56h.05a3.74 3.74 0 0 1 3.37-1.85c3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.77-.77 1.77-1.72V1.72C24 .77 23.2 0 22.22 0z"/>
        </svg>
      </a>
      <a href={SOCIAL.twitter} target="_blank" rel="noopener" aria-label="Twitter / X" title="Twitter / X">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M18.244 2H21l-6.52 7.45L22 22h-6.79l-4.74-6.2L4.8 22H2l7-8L2 2h6.91l4.27 5.67L18.244 2zm-2.38 18h1.86L7.21 4h-2L15.86 20z"/>
        </svg>
      </a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    margin-top: 6rem;
    padding: 1.5rem 0 2.5rem;
    color: var(--text-muted);
    font-size: 0.9rem;
  }
  .footer-inner {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .copy { margin: 0; }
  .copy a { color: var(--text-muted); }
  .copy a:hover { color: var(--accent); }
  .dot { margin: 0 0.4rem; color: var(--text-faint); }

  .social {
    margin-left: auto;
    display: inline-flex;
    gap: 0.25rem;
  }
  .social a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    color: var(--text-muted);
    border-radius: var(--radius-sm);
    transition: all var(--transition);
  }
  .social a:hover {
    color: var(--accent);
    background: var(--bg-elev);
  }
</style>
